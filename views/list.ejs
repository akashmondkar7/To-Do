<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task List Page</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include("navbar") %>

    <div class="container">
    <h1>Task List Page</h1>
    <form action="/multi-delete" method="POST" ">
        <button class="delete-item" style="margin-bottom: 10px">Delete Selected Tasks</button>

    <ul class="task-list">
        <% for(let task=0 ; task<result.length ; task++) {%>
            <li class="task-item">
            <div class="task-title">
               <%= result[task].title %>
            </div>
            <div class="task-description">
               <%= result[task].description %>
            </div>
             <input type="checkbox" name="selectTask[]" value="<%= result[task]._id%>">
             <button formaction="/delete/<%= result[task]._id %>" formmethod="post" class="delete-item">Delete</button>
             <button formaction="/update/<%= result[task]._id %>" formmethod="get" class="update-item">Update</button>
        </li>
            <%}%>
    </ul>
    </form>
    
    </div>
    
</body>
</html>