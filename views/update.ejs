<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Task</title>
        <link rel="stylesheet" href="/css/style.css">

</head>
<body>
        <%- include("navbar") %>

    <div class="container">
        <h1>Update Task Page</h1>
        <form class="todo-form" action="/update/<%= result._id %>" method="post">
        <input value="<%= result.title %>" type="text" placeholder="Enter Task Title" name="title">
        <br><br>
        <textarea class="input" name="description"><%= result.description %></textarea>
        <br><br>
        <button class="btn">Update Task</button>
        </form>
    </div>
</body>
</html>